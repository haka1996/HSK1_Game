  "concepts": [
    {
      "title": "Talking About Cities",
      "explanation": "Use city names to talk about places you live in, visit, or like.",
      "example_zh": "我住在北京。",
      "example_pinyin": "Wǒ zhù zài Běijīng.",
      "example_en": "I live in Beijing.",
      "note": "Use 在 (zài) to indicate location."
    },
    {
      "title": "Asking Where Someone Is",
      "explanation": "Use 哪里 (nǎlǐ) to ask where someone is.",
      "example_zh": "你在哪儿？",
      "example_pinyin": "Nǐ zài nǎr?",
      "example_en": "Where are you?",
      "note": "哪儿 (nǎr) is a spoken form of 哪里."
    }
  ],
