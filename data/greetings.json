{
  "id": 7,
  "name": "Greetings & Polite Expressions",
  "date": "-",
  "topic": "HSK 1.1",
  "concepts": [
    {
      "title": "Basic Greetings",
      "explanation": "These are the most common greetings used when meeting people.",
      "example_zh": "你好！",
      "example_pinyin": "Nǐ hǎo!",
      "example_en": "Hello!",
      "note": "您好 (Nín hǎo) is the formal version used to show respect."
    },
    {
      "title": "Time-based Greetings",
      "explanation": "Chinese greetings change depending on the time of day.",
      "example_zh": "早上好！",
      "example_pinyin": "Zǎoshang hǎo!",
      "example_en": "Good morning!",
      "note": "Use 上午好 before noon, 下午好 after noon, and 晚上好 in the evening."
    },
    {
      "title": "Asking How Someone Is",
      "explanation": "Add 吗 (ma) at the end of a sentence to make it a yes/no question.",
      "example_zh": "你好吗？",
      "example_pinyin": "Nǐ hǎo ma?",
      "example_en": "How are you?",
      "note": "A common response is 我很好 (Wǒ hěn hǎo) meaning 'I am very well.'"
    },
    {
      "title": "Apologizing",
      "explanation": "Use 对不起 to apologize and 没关系 to respond politely.",
      "example_zh": "对不起。",
      "example_pinyin": "Duìbuqǐ.",
      "example_en": "I'm sorry.",
      "note": "没关系 means 'It's okay' or 'No problem.'"
    },
    {
      "title": "Thanking Someone",
      "explanation": "Use 谢谢 to thank someone. Respond with 不客气 or 不谢.",
      "example_zh": "谢谢！",
      "example_pinyin": "Xièxie!",
      "example_en": "Thank you!",
      "note": "不客气 is much more common than 不谢 in modern Mandarin."
    },
    {
      "title": "Farewells & Wishes",
      "explanation": "Use these expressions when leaving or celebrating special occasions.",
      "example_zh": "再见！",
      "example_pinyin": "Zàijiàn!",
      "example_en": "Goodbye!",
      "note": "新年快乐 is used during the Chinese New Year."
    }
  ],
