  "concepts": [
    {
      "title": "Classroom Vocabulary",
      "explanation": "These are common words used by teachers and students in the classroom.",
      "example_zh": "老师",
      "example_pinyin": "Lǎoshī",
      "example_en": "Teacher",
      "note": "老师 is the standard way to address or refer to a teacher."
    },
    {
      "title": "Asking and Answering Questions",
      "explanation": "Use 有问题吗 to ask whether someone has any questions.",
      "example_zh": "有问题吗？",
      "example_pinyin": "Yǒu wèntí ma?",
      "example_en": "Any questions?",
      "note": "Answer with 我有问题 (I have a question) or 我没有问题 (I have no questions)."
    },
    {
      "title": "Checking Understanding",
      "explanation": "Teachers often ask whether students understand the lesson.",
      "example_zh": "懂了吗？",
      "example_pinyin": "Dǒng le ma?",
      "example_en": "Do you understand?",
      "note": "You can answer 懂了 (I understand) or 不懂 (I don't understand)."
    },
    {
      "title": "Waiting and Interrupting Politely",
      "explanation": "Use these expressions when asking someone to wait or excusing yourself.",
      "example_zh": "等一下！",
      "example_pinyin": "Děng yíxià!",
      "example_en": "Wait a moment!",
      "note": "不好意思 is a polite way to say 'Excuse me.' 对不起 is used when apologizing."
    },
    {
      "title": "Classroom Instructions",
      "explanation": "These are common instructions given by teachers during class.",
      "example_zh": "请我读。",
      "example_pinyin": "Qǐng wǒ dú.",
      "example_en": "Read after me.",
      "note": "These expressions are frequently heard in beginner Chinese classes."
    }
  ],
